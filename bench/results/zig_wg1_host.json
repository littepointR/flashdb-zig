    "sizeof_kvdb": 584,
    "sizeof_tsdb": 56,
    "sizeof_kv_iterator": 80,
    "sizeof_partition": 16,
    "note": "sizeof_kvdb includes the 128-entry name cache, the per-sector state arrays and the embedded flash driver value (sizeof_partition); partition/geometry not counted"
  },
  "semantics": {
    "checksum_fn": "FNV-1a 32: hash=0x811C9DC5; per byte: hash^=b; hash*=0x01000193 (wrapping); decimal u32",
    "kv_value_formula": "byte[j] = (seed + i*31 + j*7) & 0xFF",
    "kv_seeds": {"kv_set_small": 17, "kv_update_1k_initial": 34, "kv_get_hot": 51, "kv_delete_set": 51, "kv_large": 68},
    "ts_payload_formula": "byte[j] = (0x5A + i*13 + j*5) & 0xFF",
    "ts_timestamp_formula": "t_i = 1000 + i",
    "delete_missing_key": "Kvdb.delete returns false (the Zig API has no FDB_KV_NAME_ERR); the errcodes object counts it as name_err for C compatibility",
    "delete_missing_key_code": 5,
    "get_missing_returns": 0,
    "kv_checksum": "FNV-1a-32 over u32(entry_count), then entries sorted by key: u32(key_len), key, u32(value_len), value",
    "ts_checksum": "FNV-1a-32 over forward-iteration records: u32(status), u32(time), u32(log_len), payload[log_len]; then u32(entry_count)",
    "range_checksum": "tsl_by_time/tsl_query_count: FNV-1a-32 over u32(500), then u32(count) per query",
    "lcg": "state=12345; next: state=(state*1103515245+12345) mod 2^31; per query: off=next()%3000, len=50+next()%451; from=1000+off; to=from+len",
    "timing": "std.Io.Clock.awake (monotonic; QueryPerformanceCounter on Windows), median of runs; setup excluded from timing and flash counters",
    "flash_cost": "read_bytes*1 + write_bytes*10 + erase_bytes*100",
    "errcode_mapping": "InvalidName->name_err; SavedFull->saved_full; InitFailed|NotFormatted->init_failed; Corrupted->read_err; device errors->write_err; delete()==false->name_err",
    "get_length_semantics": "Kvdb.get returns the total value length (copied length = min(buf.len, len)); every get here passes a buffer >= the value, so hits and byte sums match the C harness",
    "ts_capacity_note": "the Zig TSDB layout (fixed 12-byte index + payload area) holds 368 max_len entries in 4x4096 sectors, while upstream FlashDB stops at 308 (write_gran 8) / 336 (write_gran 1); 'populate to full' therefore yields a different entry count and the tsl_* checksums cover a different amount of data, so they are not byte-comparable with the C document",
    "ts_parity_extras": "tsl_append/tsl_iter_fwd/tsl_iter_rev/tsl_mount/tsl_clean carry c_ref_capacity + c_ref_prefix_checksum (the same FNV serialisation over only the first c_ref_capacity entries, expected to equal the C document checksum); tsl_by_time/tsl_query_count carry c_ref_last_time + c_ref_sum + c_ref_checksum (the same LCG range loop clamped to the C timestamp window, expected to equal the C sum_*/checksum)",
    "write_gran_note": "write_gran 1 and 8 currently share the same byte-granule status representation, so their flash traffic is identical"
  },
